{
  "name": "folder-gallery",
  "version": "1.19.0",
  "description": "A lightweight web server that creates dynamic galleries from image directories",
  "main": "server.js",
  "bin": {
    "gallery": "bin/gallery.js"
  },
  "keywords": [
    "gallery",
    "images",
    "web-server",
    "express",
    "cli"
  ],
  "author": "blashbrook",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blashbrook/folder-gallery.git"
  },
  "bugs": {
    "url": "https://github.com/blashbrook/folder-gallery/issues"
  },
  "homepage": "https://github.com/blashbrook/folder-gallery#readme",
  "dependencies": {
    "chokidar": "^4.0.3",
    "commander": "^14.0.2",
    "express": "^5.1.0",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.0",
    "@semantic-release/npm": "^13.1.1",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^27.0.1",
    "semantic-release": "^25.0.1",
    "supertest": "^7.1.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "optionalDependencies": {
    "sharp": "^0.34.4"
  },
  "files": [
    "bin/",
    "server.js",
    "metadata.js",
    "macos-tags.js",
    "scripts/postinstall.js"
  ],
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "link": "npm link",
    "unlink": "npm unlink -g folder-gallery",
    "postinstall": "node scripts/postinstall.js",
    "local-install": "FG_DEV=1 node scripts/postinstall.js"
  }
}
