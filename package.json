{
  "name": "folder-gallery",
  "version": "1.3.2",
  "description": "A lightweight web server that creates dynamic galleries from image directories",
  "main": "server.js",
  "bin": {
    "gallery": "bin/gallery.js"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "gallery",
    "images",
    "web-server",
    "express",
    "cli"
  ],
  "author": "blashbrook",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blashbrook/folder-gallery.git"
  },
  "bugs": {
    "url": "https://github.com/blashbrook/folder-gallery/issues"
  },
  "homepage": "https://github.com/blashbrook/folder-gallery#readme",
  "dependencies": {
    "chokidar": "^3.5.3",
    "commander": "^11.1.0",
    "express": "^4.18.2",
    "multer": "^2.0.2",
    "open": "^10.1.0",
    "sharp": "^0.32.6"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^11.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.2.6",
    "@semantic-release/npm": "^11.0.2",
    "@semantic-release/release-notes-generator": "^12.1.0",
    "jest": "^30.2.0",
    "jsdom": "^23.0.1",
    "semantic-release": "^22.0.12",
    "supertest": "^7.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin/",
    "public/",
    "server.js",
    "metadata.js"
  ]
